{
  "manifest_version": 3,
  "name": "AI Meter Connector",
  "version": "0.2.0",
  "description": "Sends your Claude usage (5-hour and weekly limits) from this browser to the AI Meter dashboard on this computer.",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://claude.ai/*", "http://127.0.0.1:4317/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "AI Meter Connector" },
  "icons": { "32": "icon-32.png", "128": "icon-128.png" }
}
